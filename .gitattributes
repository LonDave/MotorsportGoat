# Normalizza line endings automaticamente
* text=auto

# Forza LF per file sorgente web (compatibilità Linux/Mac su GitHub Actions)
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf

# File binari — non toccare
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
